# Vue 前端环境变量配置示例
# 用途：配置前端应用运行参数
# 注意：Vite 会自动加载对应环境的配置文件（.env.development 或 .env.production）

# ==================== API 配置 ====================
# 后端 API 基础 URL
# 开发环境默认使用 vite.config.js 中的代理配置（/api -> http://localhost:8080）
# 生产环境必须设置此变量指向实际的后端地址
VITE_API_BASE_URL=https://api.yourdomain.com

# ==================== 应用配置 ====================
VITE_APP_TITLE=AI教学辅助平台
VITE_APP_VERSION=1.0.0

# ==================== 功能开关 ====================
# VITE_ENABLE_CHARTS=true
# VITE_ENABLE_CODE_HIGHLIGHT=true
# VITE_ENABLE_MARKDOWN=true

# ==================== 开发配置 ====================
# 代理配置（开发环境用于解决CORS，默认：/api=http://localhost:8080）
# VITE_PROXY_API=/api=http://localhost:8080
# VITE_USE_MOCK=false
# VITE_MOCK_DELAY=500

# ==================== 第三方服务 ====================
# VITE_GA_ID=
# VITE_SENTRY_DSN=

# ==================== UI 配置 ====================
# VITE_DEFAULT_LANGUAGE=zh-CN
# VITE_DEFAULT_THEME=auto
# VITE_PAGE_SIZE=20

# ==================== 性能配置 ====================
# VITE_ENABLE_SW=false
# VITE_PRELOAD=true

# ==================== 安全配置 ====================
# VITE_ENABLE_SIGNATURE=false
# VITE_API_TIMEOUT=30000

# ==================== 通知配置 ====================
# VITE_ENABLE_NOTIFICATION=true
# VITE_NOTIFICATION_DURATION=5000

# ==================== 文件上传配置 ====================
# VITE_MAX_UPLOAD_SIZE=10
# VITE_ALLOWED_FILE_TYPES=image/*,.pdf,.doc,.docx

# ==================== 调试配置 ====================
# VITE_DEBUG=false
# VITE_LOG_API=false