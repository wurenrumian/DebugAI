# Vue 前端环境变量配置示例
# 复制此文件为 .env.development（开发）或 .env.production（生产）
# Vite 会自动加载对应环境的配置文件

# ==================== API 配置 ====================

# 后端API基础URL（可选）
# 注意：开发环境默认使用 vite.config.js 中的代理配置（/api -> http://localhost:8080）
# 生产环境需要设置此变量指向实际的后端地址
#
# 开发环境（如需要绕过代理）：
# VITE_API_BASE_URL=http://localhost:8080
#
# 生产环境示例：
VITE_API_BASE_URL=https://api.yourdomain.com

# ==================== 应用配置 ====================

# 应用标题
VITE_APP_TITLE=AI教学辅助平台

# 应用版本
VITE_APP_VERSION=1.0.0

# ==================== 功能开关 ====================

# 是否启用ECharts图表
# 默认：true
# VITE_ENABLE_CHARTS=true

# 是否启用代码高亮
# 默认：true
# VITE_ENABLE_CODE_HIGHLIGHT=true

# 是否启用Markdown渲染
# 默认：true
# VITE_ENABLE_MARKDOWN=true

# ==================== 开发配置 ====================

# 代理配置（开发环境用于解决CORS）
# 格式：/api=target:port
# 默认：/api=http://localhost:8080
# VITE_PROXY_API=/api=http://localhost:8080

# 是否启用模拟数据（开发测试用）
# 默认：false
# VITE_USE_MOCK=false

# 模拟数据延迟（毫秒）
# 默认：500
# VITE_MOCK_DELAY=500

# ==================== 第三方服务 ====================

# Google Analytics ID（可选）
# VITE_GA_ID=

# 错误监控（Sentry等）
# VITE_SENTRY_DSN=

# ==================== UI 配置 ====================

# 默认语言：zh-CN, en-US
# 默认：zh-CN
# VITE_DEFAULT_LANGUAGE=zh-CN

# 主题：light, dark, auto
# 默认：auto
# VITE_DEFAULT_THEME=auto

# 每页显示数量
# 默认：20
# VITE_PAGE_SIZE=20

# ==================== 性能配置 ====================

# 是否启用Service Worker
# 默认：false
# VITE_ENABLE_SW=false

# 资源预加载
# 默认：true
# VITE_PRELOAD=true

# ==================== 安全配置 ====================

# 是否启用API请求签名（生产环境建议启用）
# 默认：false
# VITE_ENABLE_SIGNATURE=false

# API请求超时时间（毫秒）
# 默认：30000
# VITE_API_TIMEOUT=30000

# ==================== 通知配置 ====================

# 是否启用浏览器通知
# 默认：true
# VITE_ENABLE_NOTIFICATION=true

# 通知显示时长（毫秒）
# 默认：5000
# VITE_NOTIFICATION_DURATION=5000

# ==================== 文件上传配置 ====================

# 上传文件大小限制（MB）
# 默认：10
# VITE_MAX_UPLOAD_SIZE=10

# 支持的文件类型
# 默认：image/*,.pdf,.doc,.docx
# VITE_ALLOWED_FILE_TYPES=image/*,.pdf,.doc,.docx

# ==================== 调试配置 ====================

# 是否显示调试信息
# 默认：false（生产环境必须为false）
# VITE_DEBUG=false

# 是否记录API请求日志
# 默认：false
# VITE_LOG_API=false