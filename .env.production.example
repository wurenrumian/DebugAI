# DebugAI 生产环境配置模板
# 用途：腾讯云 Docker Compose 生产环境
# 使用方法：
# 1. 复制此文件为 .env: cp .env.production.example .env
# 2. 替换所有占位符为实际值
# 3. 运行 docker-compose up -d
#
# 注意：
# - 标记为【必需】的变量必须设置
# - 生产环境必须修改所有默认密码和密钥
# - 不同环境应使用不同的配置值

# ==================== 数据库配置 ====================
# 必需：PostgreSQL 数据库连接
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-strong-database-password>
POSTGRES_DB=debugai
DB_PORT=5432

# ==================== 缓存配置 ====================
# 必需：Redis 连接配置（用于限流、缓存、JWT黑名单等）
# Docker 网络内地址：redis:6379
# 生产环境必须设置密码！使用强随机密码（至少16字符）
REDIS_ADDR=redis:6379
REDIS_PORT=6379
REDIS_PASSWORD=<your-strong-redis-password>
REDIS_DB=0
REDIS_POOL_SIZE=10
# 可选：是否启用数据缓存（默认: true，设为 false 禁用缓存）
CACHE_ENABLED=true

# ==================== 认证安全 ====================
# 必需：JWT 签名密钥（至少32字符强随机字符串）
# 生成命令：
#   Linux/macOS: openssl rand -base64 32
#   Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=<your-64-char-jwt-secret>
JWT_EXPIRY_HOURS=24
BCRYPT_COST=10

# ==================== AI 服务配置 ====================
# 必需：DeepSeek API 密钥（从 https://platform.deepseek.com/api_keys 获取）
DEEPSEEK_API_KEY=<your-deepseek-api-key>
# 可选：AI 服务地址（默认：http://localhost:8000）
AI_SERVICE_URL=http://localhost:8000

# ==================== 服务端口 ====================
# 这些端口用于配置各个服务在 Docker 网络内或主机的监听端口
# 注意：修改这些值会改变服务的访问地址，请确保与 docker-compose.yml 中的映射一致
BACKEND_PORT=8080
AI_PORT=8000
FRONTEND_PORT=80

# ==================== 运行环境 ====================
# 可选：development | staging | production
ENV=production

# ==================== 应用配置 ====================
# 可选：通用配置
TZ=Asia/Shanghai
LOG_LEVEL=info
DEBUG=false

# ==================== 跨域配置 ====================
# 可选：允许的前端源（逗号分隔）
CORS_ALLOW_ORIGINS=http://your-domain.com

# ==================== 邮箱验证配置 ====================
# 可选：是否跳过邮箱验证（仅用于开发测试环境，生产环境必须设为 false）
SKIP_EMAIL_VERIFICATION=false
# SMTP 邮件服务器配置（如果启用邮箱验证功能则需要配置）
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
# 前端URL（用于生成验证链接，必须配置）
FRONTEND_URL=https://your-domain.com

# ==================== 部署说明 ====================
# 1. 复制此文件：cp .env.production.example .env
# 2. 编辑必需配置：
#    - POSTGRES_PASSWORD：数据库密码（强密码）
#    - JWT_SECRET：JWT密钥（至少32字符，建议64字符）
#    - DEEPSEEK_API_KEY：DeepSeek API密钥
#    - REDIS_PASSWORD：Redis密码（至少16字符）
#    - SMTP_*：邮件服务器配置（如果启用邮箱验证）
#    - FRONTEND_URL：生产环境前端URL
#    - CORS_ALLOW_ORIGINS：允许的前端源
# 3. 启动服务：docker-compose up -d
# 4. 验证状态：docker-compose ps
# 5. 查看日志：docker-compose logs -f [service-name]
#
# 生产环境建议：
# 1. 使用外部 secrets 管理（Docker Secrets / K8s Secrets）
# 2. 启用数据库 SSL 连接
# 3. 配置防火墙，仅开放必要端口
# 4. 使用域名和 HTTPS（Nginx/Traefik 反向代理）
# 5. 设置资源限制（CPU、内存）
# 6. 配置日志收集（ELK、Loki）
# 7. 设置监控告警（Prometheus、Grafana）
# 8. 定期备份数据库
# 9. 使用私有镜像仓库
# 10. 定期更新系统和依赖包
