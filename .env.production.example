# DebugAI 生产环境配置模板
# 用途：腾讯云 Docker Compose 生产环境
# 使用方法：
# 1. 复制此文件为 .env: cp .env.production.example .env
# 2. 替换所有 <> 占位符为实际值
# 3. 运行 docker-compose up -d

# ==================== 数据库配置 ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=nvvIGqYnDexalqnCalwNbWsaWypvlVWWiBaedMQg
POSTGRES_DB=debugai
DB_PORT=5432

# ==================== 缓存配置 ====================
# Docker 网络内必须使用服务名
REDIS_ADDR=redis:6379
REDIS_PORT=6379
REDIS_PASSWORD=vbeltemTeVVdgDuVdJZaqGBwckLhsnDOUKczeXDw
REDIS_DB=0
REDIS_POOL_SIZE=10

# ==================== 认证安全 ====================
# 必须：生成强随机密钥（至少32字符）
# 生成命令：openssl rand -base64 64
JWT_SECRET=A19o8b8Gv46iFv1/3hBuLOHyhS3UtjdS4oBNyWU1t4K2d118tlEagUB4gQ4bw6f+TIItj0fIA/4ePfwHiCx4rw==
JWT_EXPIRY_HOURS=24
BCRYPT_COST=10

# ==================== AI 服务配置 ====================
# 必须：从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-a9e252ec86f5400483f4cec4e67f0bbf

# ==================== 服务端口 ====================
BACKEND_PORT=8080
AI_PORT=8000
FRONTEND_PORT=80

# ==================== 运行环境 ====================
ENV=production

# ==================== 应用配置 ====================
TZ=Asia/Shanghai
LOG_LEVEL=info
DEBUG=false

# ==================== 跨域配置 ====================
# 生产环境前端地址（逗号分隔）
CORS_ALLOW_ORIGINS=http://81.70.24.33

# ==================== 邮箱验证配置 ====================
# 生产环境建议启用邮箱验证

SKIP_EMAIL_VERIFICATION=false
# SMTP 邮件服务器配置（如果启用邮箱验证功能则需要配置）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=wurenfortest@163.com
