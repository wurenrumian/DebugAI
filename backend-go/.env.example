# Go 后端服务环境变量配置示例
# 用途：定义 Go 后端服务特有的运行参数
# 注意：通用配置（数据库、Redis、JWT、AI服务等）已在根目录 .env 中定义

# ==================== 服务配置 ====================
# 服务监听端口（覆盖根目录 BACKEND_PORT）
PORT=8080
# 服务监听地址（默认：0.0.0.0）
HOST=0.0.0.0

# ==================== 可选功能配置 ====================
# 限流配置
# RATE_LIMIT_ENABLED=true

# 监控配置
# METRICS_ENDPOINT=/metrics
# ENABLE_PPROF=false

# 安全配置（如需要覆盖根目录配置）
# JWT_EXPIRY_HOURS=24
# JWT_REFRESH_EXPIRY_DAYS=7
# BCRYPT_COST=10

# 邮箱验证配置（注册前验证，必填）
# 是否跳过邮箱验证（仅用于开发测试环境，生产环境必须设为 false）
# SKIP_EMAIL_VERIFICATION=false
# SMTP 邮件服务器配置（必须配置，用于发送验证邮件）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com
# 前端URL（生产环境用于生成验证链接）
# FRONTEND_URL=https://your-frontend-domain.com

# 文件上传配置
# MAX_UPLOAD_SIZE=10
# UPLOAD_PATH=./uploads

# ==================== 开发配置 ====================
# 仅用于开发测试（生产环境必须禁用）
# SKIP_AUTH=false
# AUTO_SEED_DATA=true