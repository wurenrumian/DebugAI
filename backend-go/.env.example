# Go 后端服务环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 必需配置 ====================

# JWT 签名密钥（必需，生产环境必须修改！）
# 要求：至少32个字符，使用强随机字符串
# 生成命令（Linux/macOS）：openssl rand -base64 32
# 生成命令（Windows）：[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=your-strong-secret-key-min-32-chars-change-in-production

# 数据库连接字符串（必需，生产环境建议使用PostgreSQL）
# SQLite（开发环境）：
# DATABASE_URL=data.db
# 或使用独立参数：
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_NAME=debugai
# DB_PORT=5432
# DB_SSLMODE=disable
#
# PostgreSQL（生产环境）：
# DATABASE_URL=postgresql://user:password@localhost:5432/debugai?sslmode=require
# 或使用独立参数：
DATABASE_URL=postgresql://postgres:password@localhost:5432/debugai?sslmode=disable

# ==================== 服务配置 ====================

# Python AI 服务地址（必需）
# 默认：http://localhost:8000
AI_SERVICE_URL=http://localhost:8000

# 服务监听端口
# 默认：8080
PORT=8080

# 服务监听地址
# 默认：0.0.0.0
HOST=0.0.0.0

# ==================== Redis 配置（可选但推荐）====================

# Redis 地址（用于JWT黑名单、缓存等）
# 默认：localhost:6379
# REDIS_ADDR=localhost:6379

# Redis 密码（如无密码则留空）
# REDIS_PASSWORD=

# Redis 数据库编号
# 默认：0
# REDIS_DB=0

# Redis 连接池大小
# 默认：10
# REDIS_POOL_SIZE=10

# ==================== CORS 配置 ====================

# 允许的CORS源（多个用逗号分隔）
# 默认：http://localhost:5173
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://yourdomain.com

# ==================== 限流配置 ====================

# 是否启用限流
# 默认：true
# RATE_LIMIT_ENABLED=true

# 调试模式（输出详细日志）
# 默认：false（生产环境必须为false）
DEBUG=false

# ==================== 监控配置 ====================

# Prometheus指标端点
# 默认：/metrics
# METRICS_ENDPOINT=/metrics

# 是否启用性能分析
# 默认：false
# ENABLE_PPROF=false

# ==================== 安全配置 ====================

# Token有效期（小时）
# 默认：24
# JWT_EXPIRY_HOURS=24

# 刷新Token有效期（天）
# 默认：7
# JWT_REFRESH_EXPIRY_DAYS=7

# 密码加密成本（bcrypt）
# 默认：10
# BCRYPT_COST=10

# ==================== 邮件配置（可选）====================

# SMTP服务器地址
# SMTP_HOST=smtp.gmail.com

# SMTP端口
# SMTP_PORT=587

# SMTP用户名
# SMTP_USERNAME=

# SMTP密码
# SMTP_PASSWORD=

# 发件人邮箱
# SMTP_FROM=noreply@yourdomain.com

# ==================== 文件上传配置 ====================

# 上传文件大小限制（MB）
# 默认：10
# MAX_UPLOAD_SIZE=10

# 上传文件存储路径
# 默认：./uploads
# UPLOAD_PATH=./uploads

# ==================== 开发配置 ====================

# 是否跳过认证（仅用于开发测试）
# 默认：false（生产环境必须为false）
# SKIP_AUTH=false

# 是否自动创建默认数据（管理员用户、默认薄弱点关键词等）
# 默认：true
# AUTO_SEED_DATA=true