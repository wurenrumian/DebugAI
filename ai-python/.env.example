# AI Python 服务环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 必需配置 ====================

# DeepSeek API 密钥（必需）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# ==================== 可选配置 ====================

# 运行环境：development, staging, production
# 默认：development
ENV=development

# LLM API 配置（如需自定义）
# 默认：https://api.deepseek.com
# AI_SERVICE_BASE_URL=https://api.deepseek.com

# 模型名称（如需自定义）
# 默认：deepseek-chat
# AI_MODEL_NAME=deepseek-chat

# 温度参数：0.0-2.0，越高越随机
# 默认：0.3
# AI_TEMPERATURE=0.3

# 最大Token数
# 默认：8192
# AI_MAX_TOKENS=8192

# 请求超时时间（秒）
# 默认：60
# AI_REQUEST_TIMEOUT=60

# ==================== 日志配置 ====================

# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
# 默认：INFO
# LOG_LEVEL=INFO

# 日志文件路径（为空则输出到控制台）
# LOG_FILE=

# ==================== 性能配置 ====================

# 并发请求数限制
# 默认：10
# MAX_CONCURRENT_REQUESTS=10

# 响应缓存时间（秒，0表示禁用缓存）
# 默认：300
# RESPONSE_CACHE_TTL=300

# ==================== 调试配置 ====================

# 启用详细调试日志
# 默认：false
# DEBUG=false

# 模拟LLM响应（用于测试，不消耗API配额）
# 默认：false
# MOCK_LLM=false