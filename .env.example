# DebugAI 项目环境变量配置示例
# 用途：定义 Docker Compose 编排下所有服务所需的配置
# 使用方法：复制为 .env 文件并填入实际值，然后执行 `docker-compose up -d`
#
# 注意：
# - 标记为【必需】的变量必须在 .env 中设置
# - 生产环境必须修改所有默认密码和密钥
# - 不同环境应使用不同的配置值

# ==================== 数据库配置 ====================
# 必需：PostgreSQL 数据库连接
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-database-password-change-in-production
POSTGRES_DB=debugai
DB_PORT=5432

# ==================== 缓存配置 ====================
# 可选：Redis 连接配置（用于限流、缓存、JWT黑名单等）
# Docker 网络内地址：redis:6379
REDIS_ADDR=localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
# 可选：是否启用数据缓存（默认: true，设为 false 禁用缓存）
CACHE_ENABLED=true

# ==================== 认证安全 ====================
# 必需：JWT 签名密钥（至少32字符强随机字符串）
# 生成命令：
#   Linux/macOS: openssl rand -base64 32
#   Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=your-strong-secret-key-min-32-chars-change-in-production
JWT_EXPIRY_HOURS=24
BCRYPT_COST=10

# ==================== AI 服务配置 ====================
# 必需：DeepSeek API 密钥（从 https://platform.deepseek.com/api_keys 获取）
DEEPSEEK_API_KEY=sk-your-api-key-here
# 可选：AI 服务地址（默认：http://localhost:8000）
AI_SERVICE_URL=http://localhost:8000

# ==================== 服务端口 ====================
# 映射到主机的端口（修改以避免冲突）
BACKEND_PORT=8080
AI_PORT=8000
FRONTEND_PORT=80

# ==================== 运行环境 ====================
# 可选：development | staging | production
ENV=development

# ==================== 应用配置 ====================
# 可选：通用配置
TZ=Asia/Shanghai
LOG_LEVEL=info
DEBUG=false

# ==================== 跨域配置 ====================
# 可选：允许的前端源（逗号分隔）
CORS_ALLOW_ORIGINS=http://localhost:5173

# ==================== 邮箱验证配置 ====================
# 可选：是否跳过邮箱验证（仅用于开发测试环境，生产环境必须设为 false）
# SKIP_EMAIL_VERIFICATION=false
# SMTP 邮件服务器配置（如果启用邮箱验证功能则需要配置）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com
# 前端URL（用于生成验证链接，必须配置）
# FRONTEND_URL=http://localhost:5173

# ==================== 部署说明 ====================
# 1. 复制此文件：cp .env.example .env
# 2. 编辑必需配置：
#    - POSTGRES_PASSWORD：数据库密码
#    - JWT_SECRET：JWT密钥（至少32字符）
#    - DEEPSEEK_API_KEY：DeepSeek API密钥
# 3. 启动服务：docker-compose up -d
# 4. 验证状态：docker-compose ps
# 5. 查看日志：docker-compose logs -f [service-name]
#
# 服务名称：
# - postgres      (PostgreSQL 16)
# - redis         (Redis 7)
# - backend       (Go 后端 API)
# - ai-service    (Python AI 服务)
# - frontend      (Vue 前端)
#
# 生产环境建议：
# 1. 修改所有默认密码和密钥
# 2. 使用外部 secrets 管理（Docker Secrets / K8s Secrets）
# 3. 启用数据库 SSL 连接
# 4. 配置防火墙，仅开放必要端口
# 5. 使用域名和 HTTPS（Nginx/Traefik 反向代理）
# 6. 设置资源限制（CPU、内存）
# 7. 配置日志收集（ELK、Loki）
# 8. 设置监控告警（Prometheus、Grafana）
# 9. 定期备份数据库
# 10. 使用私有镜像仓库