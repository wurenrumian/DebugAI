# DebugAI 项目根目录环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 此文件供根目录 docker-compose.yml 使用

# ==================== PostgreSQL 数据库配置 ====================

# 数据库用户名
# 默认：postgres
POSTGRES_USER=postgres

# 数据库密码（必需，生产环境必须修改！）
POSTGRES_PASSWORD=your-database-password-change-in-production

# 数据库名称
# 默认：debugai
POSTGRES_DB=debugai

# 数据库端口映射
# 默认：5432
DB_PORT=5432

# ==================== JWT 配置 ====================

# JWT 签名密钥（必需，生产环境必须修改！）
# 要求：至少32个字符，使用强随机字符串
# 注意：此密钥用于 Go 后端服务
JWT_SECRET=your-strong-secret-key-min-32-chars-change-in-production

# ==================== 服务端口配置 ====================

# 后端服务端口映射
# 默认：8080
BACKEND_PORT=8080

# AI 服务端口映射
# 默认：8000
AI_PORT=8000

# 前端服务端口映射
# 默认：80
FRONTEND_PORT=80

# ==================== 运行环境 ====================

# 环境：development, staging, production
# 默认：development
ENV=development

# ==================== 可选配置 ====================

# 时区
# 默认：Asia/Shanghai
TZ=Asia/Shanghai

# 日志级别
# 默认：info
LOG_LEVEL=info

# 是否启用调试
# 默认：false（生产环境必须为false）
DEBUG=false

# ==================== 安全配置 ====================

# 生成强密钥的命令：
# Linux/macOS: openssl rand -base64 32
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#
# 生产环境建议：
# 1. 使用密码管理器生成并存储密钥
# 2. 定期轮换密钥（需配合双Token机制）
# 3. 不同环境使用不同密钥
# 4. 不要将真实密钥提交到版本控制系统

# ==================== 使用说明 ====================
#
# 1. 复制此文件为 .env：
#    cp .env.example .env
#
# 2. 编辑 .env 文件，填入实际值：
#    - POSTGRES_PASSWORD: 数据库密码
#    - JWT_SECRET: JWT签名密钥（至少32字符）
#
# 3. 启动服务：
#    docker-compose up -d
#
# 4. 验证服务状态：
#    docker-compose ps
#
# 5. 查看日志：
#    docker-compose logs -f [service-name]
#
# 可用服务名：
# - postgres      (PostgreSQL 数据库)
# - backend       (Go 后端服务)
# - ai-service    (Python AI 服务)
# - frontend      (Vue 前端服务)
#
# ==================== 生产环境部署建议 ====================
#
# 1. 修改所有默认密码和密钥
# 2. 使用外部 secrets 管理（如 Docker Secrets、K8s Secrets）
# 3. 启用数据库 SSL 连接
# 4. 配置防火墙规则，仅开放必要端口
# 5. 使用域名和 HTTPS（配置 Nginx/Traefik 反向代理）
# 6. 设置资源限制（CPU、内存）
# 7. 配置日志收集（ELK、Loki 等）
# 8. 设置监控告警（Prometheus、Grafana）
# 9. 定期备份数据库
# 10. 使用私有镜像仓库